# .env のひな形。実際の値を入れた .env は Git に含めないこと（.gitignoreで除外済み）
# VPSでは /root/backend/.env に置く。変更後は pm2 restart aresoredorekore-backend

# 新規アカウント登録に必要な合言葉
REGISTER_CODE=ここに登録コード

# セッション署名鍵。未設定だと起動ごとにランダム生成され、再起動でログインが切れる
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ここにランダムな長い文字列

# Gemini APIキー（https://aistudio.google.com で発行・クレジットカード不要）
GEMINI_API_KEY=ここにAPIキー

# 本番では production にする（secure cookieの判定に使う）
NODE_ENV=production
