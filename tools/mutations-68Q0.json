  "suite": "tests/version.js",
  "from": "x[0] !== y[0] ? x[0] > y[0] : x[1] > y[1]",
  "to": "x[0] !== y[0] ? x[0] > y[0] : x[1] >= y[1]",
  "expect": "版の比べ方"
 }
]
